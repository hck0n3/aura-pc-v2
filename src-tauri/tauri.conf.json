{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aura",
  "version": "1.5.0-rc.2",
  "identifier": "com.hck0n3.aura",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Aura",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "publisher": "hck0n3",
    "copyright": "Aura © 2026 hck0n3. Basado en Limusic — GPL-3.0",
    "targets": ["deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libmpv2", "libc6 (>= 2.39)"]
      },
      "rpm": {
        "depends": [
          "libappindicator-gtk3",
          "mpv-libs",
          "libssl.so.3()(64bit)",
          "libcrypto.so.3()(64bit)"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hck0n3/aura-pc-v2/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNjU3MjQ0QUNGMUVGRDkKUldUWjcvR3NSSEpsYTB3R0plR2JJc1MvVW5vYURZdEJlbHBZZDIzaHUzSmc4MHI3WmlBdlNETEIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
